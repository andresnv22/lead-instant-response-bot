OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Seguridad del webhook (X-Webhook-Secret header obligatorio si se configura)
WEBHOOK_SECRET=cambia_este_secreto

# Correo SMTP para respuesta inmediata al lead
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password

# Persistencia SQLite + Excel
DATABASE_PATH=leads.db
LEADS_EXCEL_PATH=leads_calificados.xlsx
